# LLM Provider: "gemini" (default), "lmstudio", or "fallback"
LLM_PROVIDER=gemini

# Google Gemini API Configuration (Get key from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Optional Local LM Studio Configuration
LMSTUDIO_URL=http://localhost:1234/v1/chat/completions
LMSTUDIO_MODEL=local-model

# Optional QNX Toolchain & Target Overrides
# Leave commented out to auto-detect from $QNX_HOST / PATH and repo-relative ./target
# QNX_ADDR2LINE=ntox86_64-addr2line
# TARGET_DIR=../target
# TARGET_BINARY=../target/brake_sim_buggy
UDP_PORT=9999
